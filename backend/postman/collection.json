            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/_allauth/browser/v1/auth/password/reset",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "_allauth",
                "browser",
                "v1",
                "auth",
                "password",
                "reset"
              ]
            },
            "description": "Sets `{{newPassword}}` using `{{resetKey}}`. 200 or 401 (signed in or not, depending on settings); 400 for a bad key or weak password.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"{{resetKey}}\",\n  \"password\": \"{{newPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is one of [200, 400, 401]', () => pm.expect(pm.response.code).to.be.oneOf([200, 400, 401]));",
                  "pm.test('allauth response shape', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('status', pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
