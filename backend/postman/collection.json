    {
      "name": "2. Current user",
      "item": [
        {
          "name": "Get CSRF cookie and current user (GET /api/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "me"
              ]
            },
            "description": "**Run this first.** Returns the signed-in user (200, envelope) or 401 when signed out. Either way it sets the `csrftoken` cookie, which the collection copies into `{{csrfToken}}` for every write."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is one of [200, 401]', () => pm.expect(pm.response.code).to.be.oneOf([200, 401]));",
                  "if (pm.response.code === 200) {",
                  "  pm.test('success envelope', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.equal(true);",
                  "    pm.expect(body).to.have.property('data');",
                  "  });",
                  "  pm.test('returns the user', () => pm.expect(pm.response.json().data).to.include.keys('id', 'email'));",
                  "} else {",
                  "  pm.test('error envelope', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.success).to.equal(false);",
                  "    pm.expect(body).to.have.keys('success', 'status_code', 'message', 'code', 'errors');",
                  "  });",
                  "}",
                  "pm.test('csrftoken cookie is set', () => pm.expect(pm.cookies.has('csrftoken')).to.equal(true));"
                ]
              }
            }
          ]
        }
      ]
    },
