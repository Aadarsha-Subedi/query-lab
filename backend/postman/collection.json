      ]
    },
    {
      "name": "5. Log out",
      "item": [
        {
          "name": "Log out",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/_allauth/browser/v1/auth/session",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "_allauth",
                "browser",
                "v1",
                "auth",
                "session"
              ]
            },
            "description": "Ends the session. allauth answers 401 (no longer authenticated), which is the expected result."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is one of [401]', () => pm.expect(pm.response.code).to.be.oneOf([401]));",
                  "pm.test('allauth response shape', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('status', pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
