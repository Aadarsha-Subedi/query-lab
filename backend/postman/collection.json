              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is one of [200, 401]', () => pm.expect(pm.response.code).to.be.oneOf([200, 401]));",
                  "pm.test('allauth response shape', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('status', pm.response.code);",
