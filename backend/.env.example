# Querylab backend. Copy to `.env` and fill in. Every key is required: the
# backend refuses to start if any is missing (no setting has a fallback).
# A test checks that this file lists exactly the keys the code reads.

# ── Django ──
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ── Databases (hosts are Docker Compose service names) ──
# Credentials must match POSTGRES_USER / POSTGRES_PASSWORD in the root .env.
APP_DATABASE_URL=postgres://querylab:querylab@postgres:5432/querylab_app
DATA_PRIMARY_URL=postgres://querylab:querylab@postgres:5432/querylab
# The read-only role; bootstrap_data_db creates it with this password.
DATA_READER_URL=postgres://querylab_reader:change-me-reader@postgres:5432/querylab
# infra/sql, relative to backend/ (mounted at /infra/sql in Docker).
DATA_SQL_DIR=../infra/sql

# ── Reader limits ──
READER_STATEMENT_TIMEOUT_MS=5000

# ── Demo dataset (Olist) ──
# The CSVs inside the container (infra/data/olist is mounted here).
DEMO_DATA_DIR=/data/olist
# Moves the newest order (2018-10-17) to 2026-10-17. Fixed, so eval answers stay reproducible.
DEMO_DATE_SHIFT_DAYS=2922

# ── Redis and Huey ──
REDIS_URL=redis://redis:6379/0
HUEY_WORKERS=2
HUEY_IMMEDIATE=false

# ── Cache (Django cache: rate-limit counters, cached lookups) ──
CACHE_URL=rediscache://redis:6379/1
CACHE_DEFAULT_TIMEOUT_SECONDS=300

# ── Email (Gmail SMTP with an App Password; needs 2-step verification) ──
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
EMAIL_USE_TLS=true
EMAIL_TIMEOUT_SECONDS=10
DEFAULT_FROM_EMAIL=Querylab <you@gmail.com>

# ── OAuth (callback: <FRONTEND_URL>/accounts/<provider>/login/callback/) ──
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ── Auth rules ──
PASSWORD_MIN_LENGTH=10
BLOCK_DISPOSABLE_EMAILS=true

# ── Rate limits ──
# allauth format: <count>/<period><unit>/<key>, comma-separated; unit s, m, h or d; key ip, user or key.
RATE_LIMIT_LOGIN=30/m/ip
RATE_LIMIT_LOGIN_FAILED=10/m/ip,5/5m/key
RATE_LIMIT_SIGNUP=20/m/ip
RATE_LIMIT_CONFIRM_EMAIL=1/3m/key
RATE_LIMIT_RESET_PASSWORD=20/m/ip,5/m/key
RATE_LIMIT_CHANGE_PASSWORD=5/m/user
# ninja format: <count>/<unit>, unit s, m, h or d.
THROTTLE_ANON_RATE=60/m
THROTTLE_USER_RATE=600/m
THROTTLE_ASK_RATE=10/m
# Proxy hops in front of the app (0 locally); used to find the real client IP.
TRUSTED_PROXY_COUNT=0

# ── Pagination ──
PAGINATION_DEFAULT_LIMIT=25
PAGINATION_MAX_LIMIT=100

# ── Health ──
HEALTH_CHECK_TIMEOUT_SECONDS=3

# ── Secrets at rest ──
# Fernet keys, comma-separated, newest first. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEYS=generate-a-fernet-key

# ── LLM providers (bring your own key; the first model in each list is the default) ──
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TEMPERATURE=0.2
LLM_OPENAI_MODELS=gpt-5-mini,gpt-5-nano,gpt-4.1-mini,gpt-4.1,gpt-5
LLM_GEMINI_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash,gemini-2.5-pro

# ── Workspaces (used from step 5) ──
MAX_WORKSPACES_PER_USER=3

# ── Logging ──
LOG_LEVEL=INFO
# color (local) or json (production)
LOG_FORMAT=color

# ── Web server (production container: gunicorn) ──
PORT=8000
WEB_CONCURRENCY=2
WEB_THREADS=4
WEB_TIMEOUT_SECONDS=60
