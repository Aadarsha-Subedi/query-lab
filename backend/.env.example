# Querylab backend. Copy to `.env` and fill in. Every key is required: the
# backend refuses to start if any is missing (no setting has a fallback).
# A test checks that this file lists exactly the keys the code reads.

# Django
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Databases
# Hosts are Docker Compose service names.
# Credentials must match POSTGRES_USER / POSTGRES_PASSWORD in the root .env.
APP_DATABASE_URL=postgres://querylab:querylab@postgres:5432/querylab_app
DATA_PRIMARY_URL=postgres://querylab:querylab@postgres:5432/querylab
# The read-only role; bootstrap_data_db creates it with this password.
DATA_READER_URL=postgres://querylab_reader:change-me-reader@postgres:5432/querylab
# infra/sql, relative to backend/ (mounted at /infra/sql in Docker).
DATA_SQL_DIR=../infra/sql

# Reader limits
READER_STATEMENT_TIMEOUT_MS=5000

# Demo dataset (Olist)
# The CSVs inside the container (infra/data/olist is mounted here).
DEMO_DATA_DIR=/data/olist
# Moves the newest order (2018-10-17) to 2026-10-17. Fixed, so eval answers stay reproducible.
DEMO_DATE_SHIFT_DAYS=2922

# Redis and Huey
REDIS_URL=redis://redis:6379/0
HUEY_WORKERS=2
HUEY_IMMEDIATE=false

# Cache
# Django cache: rate-limit counters, cached lookups.
CACHE_URL=rediscache://redis:6379/1
CACHE_DEFAULT_TIMEOUT_SECONDS=300

# OAuth
# The only way to sign in. Callback: <FRONTEND_URL>/accounts/<provider>/login/callback/
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Auth rules
PASSWORD_MIN_LENGTH=10
BLOCK_DISPOSABLE_EMAILS=true

# Rate limits
# ninja format: <count>/<unit>, unit s, m, h or d.
THROTTLE_ANON_RATE=60/m
THROTTLE_USER_RATE=600/m
THROTTLE_ASK_RATE=10/m
# Proxy hops in front of the app (0 locally); used to find the real client IP.
TRUSTED_PROXY_COUNT=0

# Pagination
PAGINATION_DEFAULT_LIMIT=25
PAGINATION_MAX_LIMIT=100

# Health
HEALTH_CHECK_TIMEOUT_SECONDS=3

# Secrets at rest
# Fernet keys, comma-separated, newest first. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEYS=generate-a-fernet-key

# LLM providers
# Users bring their own key. The first model in each list is the default.
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TEMPERATURE=0.2
LLM_OPENAI_MODELS=gpt-5-mini,gpt-5-nano,gpt-4.1-mini,gpt-4.1,gpt-5
LLM_GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-pro-preview
# QueryLab's own Gemini key, used for users who have not saved a key of their
# own. Get one at https://aistudio.google.com/apikey . Keep it only in .env.
LLM_DEFAULT_GEMINI_API_KEY=your-gemini-api-key
# The model for the default key; must be one of LLM_GEMINI_MODELS.
LLM_DEFAULT_MODEL=gemini-3.5-flash

# Workspaces
# Limits (step 5), per workspace and per user.
MAX_WORKSPACES_PER_USER=3
WORKSPACE_MAX_COLUMNS=100
WORKSPACE_MAX_TABLES=20
WORKSPACE_MAX_RELATIONS=30
WORKSPACE_MAX_BYTES=52428800
USER_MAX_BYTES=262144000
WORKSPACE_NAME_MAX_LENGTH=60
# Longest description of a workspace table or column (characters).
# How long a measured workspace size is reused before the catalog is asked again
# (seconds; 0 turns the cache off). Checks right after a write always measure fresh.
QUOTA_CACHE_SECONDS=10
# Creating and deleting workspaces (step 5), per signed-in user.
THROTTLE_WORKSPACE_RATE=10/m

# Workspace roles and connections
# Workspace roles (step 5). Every workspace gets two login roles whose passwords
# are derived (HMAC) from this secret and the workspace id, never stored. Rotating
# it changes every workspace password: reprovision after. Generate a long random
# string; keep it only here.
MASTER_WORKSPACE_SECRET=local-dev-master-workspace-secret-change-me
# Where workspace roles connect (libpq key=value, no user or password). In
# production these are Neon's pooled (PgBouncer) endpoints: the primary for the
# user's own SQL, and row edits, the replica for the agent.
WORKSPACE_PRIMARY_CONNINFO=host=postgres port=5432 dbname=querylab
WORKSPACE_READER_CONNINFO=host=postgres port=5432 dbname=querylab
# Role defaults set on every workspace role (milliseconds / connections).
WORKSPACE_STATEMENT_TIMEOUT_MS=10000
WORKSPACE_IDLE_TX_TIMEOUT_MS=15000
WORKSPACE_RW_CONNECTION_LIMIT=4
WORKSPACE_RO_CONNECTION_LIMIT=4

# Workspace SQL console
# The user's own SQL on their own schema (step 5).
WORKSPACE_SQL_MAX_CHARS=20000
WORKSPACE_SQL_MAX_STATEMENTS=20
WORKSPACE_SQL_MAX_ROWS=500
WORKSPACE_SQL_MAX_CONCURRENT=1
THROTTLE_WORKSPACE_SQL_RATE=30/m

# Dump import (R2 object storage; the browser uploads straight to the bucket)
# R2_* are empty until the owner fills them in .env; DUMP_* are limits.
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
DUMP_MAX_FILE_BYTES=52428800
DUMP_MAX_STATEMENTS=200000
# What the dump may grow to once unzipped (guards gzip bombs), and how long the
# import transaction may run in total / sit idle between statements (ms).
DUMP_MAX_TEXT_BYTES=524288000
DUMP_STATEMENT_TIMEOUT_MS=300000
DUMP_PRESIGN_SECONDS=900
THROTTLE_WORKSPACE_IMPORT_RATE=10/h

# Logging
LOG_LEVEL=INFO
# color (local) or json (production)
LOG_FORMAT=color

# Web server
# Production container: gunicorn.
PORT=8000
WEB_CONCURRENCY=2
WEB_THREADS=4
WEB_TIMEOUT_SECONDS=60

# Ask
# Text-to-SQL (step 1).
ASK_MAX_QUESTION_CHARS=500
# Rows returned (and the LIMIT forced onto every query) and the size cap on a result.
ASK_MAX_ROWS=200
ASK_MAX_RESULT_BYTES=1000000
# Repair retries after a guard rejection or a database error.
ASK_MAX_REPAIR_ATTEMPTS=1
ASK_SCHEMA_CACHE_SECONDS=600
# Example values sent to the model for low-cardinality text columns (demo schema only).
ASK_SAMPLE_VALUES_MAX=8
ASK_SAMPLE_VALUES_MAX_DISTINCT=12
# Functions the guard refuses (any pg_* or lo_* function is refused too).
ASK_DENIED_FUNCTIONS=pg_sleep,pg_read_file,pg_read_binary_file,pg_ls_dir,set_config,dblink,current_setting,txid_current,nextval,setval,currval,lastval,query_to_xml,table_to_xml,cursor_to_xml,schema_to_xml,database_to_xml
# Asks per user per day on QueryLab's own default key (a user's own key is exempt).
ASK_DEFAULT_KEY_DAILY_LIMIT=20

# Confidence score
# Weights of the confidence heuristic (the positive weights sum to 1). The model's own
# rating is not used: it was about 1.0 on every answer (step 2).
CONFIDENCE_WEIGHT_CLEAN_GUARD=0.2
CONFIDENCE_WEIGHT_NO_REVISION=0.3
CONFIDENCE_WEIGHT_NON_EMPTY=0.15
CONFIDENCE_WEIGHT_REFLECT_OK=0.2
CONFIDENCE_WEIGHT_SAMPLES_CHECKED=0.15
CONFIDENCE_PENALTY_TRUNCATED=0.1
# Accuracy of the top confidence bucket must beat the bottom one by this much on the
# Olist run before the API shows a number (3.9.4). Set CONFIDENCE_SHOW_SCORE=true then.
CONFIDENCE_MIN_SEPARATION=0.2
CONFIDENCE_SHOW_SCORE=false

# Agent (step 3)
# Budgets per run. A run stops with a typed error when any of them is spent.
AGENT_MAX_STEPS=24
AGENT_MAX_LLM_CALLS=10
# Input plus output tokens over the whole run.
AGENT_MAX_TOKENS=60000
# Times the agent may propose new SQL after the first (reflect or a query error).
AGENT_MAX_REVISIONS=2
# Retries when the model's reply is not one valid JSON tool call (each is an LLM call).
AGENT_MAX_PARSE_RETRIES=1
# Time the agent is working; the wait for the user's approval does not count.
AGENT_RUN_TIMEOUT_SECONDS=120
# Redis state of a run, and how long a paused run waits for approval before it expires.
AGENT_STATE_TTL_SECONDS=7200
AGENT_APPROVAL_TTL_SECONDS=1800
# Result rows shown to the model and kept in a step, and the size cap on stored step output.
AGENT_RESULT_PREVIEW_ROWS=5
AGENT_STEP_OUTPUT_MAX_CHARS=2000
AGENT_SAMPLE_VALUES_LIMIT=8
# Start the agent with the full schema text instead of table names only (3.4.4 fallback).
AGENT_FULL_SCHEMA_START=false
# Always ask the model to review a result, not only flagged ones (empty, truncated, 1 by 1, error).
AGENT_REFLECT_ALWAYS=false
# Unfinished runs one user may have at once, and open event streams on the whole server.
AGENT_MAX_CONCURRENT_RUNS_PER_USER=2
AGENT_MAX_OPEN_STREAMS=3
# SSE: seconds between heartbeat comments, how long one Redis read blocks, and the
# longest an open stream stays (it must outlast AGENT_RUN_TIMEOUT_SECONDS).
AGENT_SSE_HEARTBEAT_SECONDS=15
AGENT_SSE_READ_BLOCK_MS=5000
AGENT_SSE_MAX_SECONDS=300
# Entries kept in a run's Redis event stream.
AGENT_EVENTS_MAXLEN=100
# Agent runs started per user (ninja format).
THROTTLE_AGENT_RATE=6/m

# Schema browser (step 4)
# Show example values for low-cardinality text columns in GET /api/schema.
SCHEMA_API_INCLUDE_SAMPLES=false
# Throttle for GET /api/agent/runs/{id}/result, which re-runs the stored SQL
# (ninja format).
THROTTLE_RESULT_RATE=20/m

# Eval harness (step 2)
# Run on a dev machine only (make eval); never in the production container.
# Decimal places numbers are rounded to when comparing two result sets.
EVAL_ROW_COMPARE_PRECISION=2
# Most rows read from each side of a comparison, and the per-query time limit.
EVAL_MAX_COMPARE_ROWS=1000
EVAL_QUERY_TIMEOUT_MS=10000
# Key for the OpenAI baseline (the Gemini baseline uses LLM_DEFAULT_GEMINI_API_KEY).
EVAL_OPENAI_API_KEY=your-openai-api-key
# Where Spider is unpacked (the compose file mounts infra/data/spider here).
EVAL_SPIDER_DIR=/data/spider
# Bucket edges for the confidence-versus-accuracy table.
EVAL_CONFIDENCE_BUCKETS=0.5,0.7,0.85
# Retries (with doubling backoff from the seconds below) when the provider is
# rate-limited, overloaded or slow, and the number of LLM calls above
# which run_eval asks for --yes.
EVAL_LLM_RETRIES=4
EVAL_RETRY_BACKOFF_SECONDS=10
# Pause between questions, so a free-tier key stays under its requests-per-minute limit.
EVAL_CALL_DELAY_SECONDS=6
EVAL_CONFIRM_ABOVE_CALLS=100
# USD per million tokens as model:input:output, used for the cost estimate only.
EVAL_MODEL_PRICES=gemini-3.5-flash:0.30:2.50,gpt-5-mini:0.25:2.00

# Trace-driven evals (step 6)
# Evals run in the dev container only.
# Runs older than this many days are not offered as eval candidates.
TRACES_CANDIDATE_MAX_AGE_DAYS=90
# Two questions of the same kind and tables merge into one cluster when the share of
# words they have in common (Jaccard, 0 to 1) is at least this.
TRACES_CLUSTER_SIMILARITY=0.5
# Most runs read in one clustering pass, so memory stays bounded.
TRACES_CLUSTER_MAX_RUNS=5000
# The model that drafts expected SQL (must be one of LLM_GEMINI_MODELS), and the most
# cluster representatives drafted by one batch.
TRACES_DRAFT_MODEL=gemini-3.5-flash
TRACES_DRAFT_MAX_PER_BATCH=20
# Largest page the workbench endpoints return.
TRACES_PAGE_SIZE_MAX=100

# Regression gate (step 6)
# Regression gate: fail when accuracy falls by more than this many percentage points,
# or when fewer cases than the minimum are shared with the baseline.
EVAL_GATE_MAX_DROP_POINTS=2.0
EVAL_GATE_MIN_CASES=20

# Feedback
# Longest note a person may leave with a thumbs up or down on a run.
FEEDBACK_NOTE_MAX_CHARS=500

# Fine-tuning (step 7)
# Offline fine-tune (step 7), never used by the web app: the model to tune, where
# dataset files are written, the share of train databases held for validation, the
# shuffle seed, and the cap on examples (0 = no cap).
FINETUNE_BASE_MODEL=Qwen/Qwen2.5-Coder-3B-Instruct
FINETUNE_OUTPUT_DIR=/data/finetune
FINETUNE_VALIDATION_FRACTION=0.1
FINETUNE_SEED=42
FINETUNE_MAX_EXAMPLES=0
