# Django
DJANGO_SETTINGS_MODULE=config.settings.test
DJANGO_SECRET_KEY=test-secret-key-not-for-production
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=testserver,localhost
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Databases
APP_DATABASE_URL=postgres://querylab:querylab@postgres:5432/querylab_app
DATA_PRIMARY_URL=postgres://querylab:querylab@postgres:5432/querylab
DATA_READER_URL=postgres://querylab_reader_test:querylab-reader-test@postgres:5432/querylab
DATA_SQL_DIR=../infra/sql

# Reader limits
READER_STATEMENT_TIMEOUT_MS=1000

# Demo dataset (Olist)
DEMO_DATA_DIR=core/tests/fixtures/olist
DEMO_DATE_SHIFT_DAYS=2922

# Redis and Huey
REDIS_URL=redis://redis:6379/2
HUEY_WORKERS=1
HUEY_IMMEDIATE=true

# Cache
CACHE_URL=locmemcache://
CACHE_DEFAULT_TIMEOUT_SECONDS=300

# OAuth
GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret
GITHUB_CLIENT_ID=test-github-client-id
GITHUB_CLIENT_SECRET=test-github-client-secret

# Auth rules
PASSWORD_MIN_LENGTH=10
BLOCK_DISPOSABLE_EMAILS=true

# Rate limits
THROTTLE_ANON_RATE=60/m
THROTTLE_USER_RATE=600/m
THROTTLE_ASK_RATE=10/m
TRUSTED_PROXY_COUNT=0

# Pagination
PAGINATION_DEFAULT_LIMIT=25
PAGINATION_MAX_LIMIT=100

# Health
HEALTH_CHECK_TIMEOUT_SECONDS=3

# Secrets at rest
ENCRYPTION_KEYS=F76adauDkbPc0pgQzVGNYOvLZSyLW5I8clBpRzXYUSs=,J6elXPVg0I0fsz46P7Jp-47tyKQm5zJp7FJUrh_fkEI=

# LLM providers
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TEMPERATURE=0.2
LLM_OPENAI_MODELS=gpt-5-mini,gpt-5-nano
LLM_GEMINI_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash
LLM_DEFAULT_GEMINI_API_KEY=test-gemini-key
LLM_DEFAULT_MODEL=gemini-2.5-flash-lite

# Workspaces
MAX_WORKSPACES_PER_USER=3

# Logging
LOG_LEVEL=WARNING
LOG_FORMAT=json

# Web server
PORT=8000
WEB_CONCURRENCY=1
WEB_THREADS=1
WEB_TIMEOUT_SECONDS=60

# Ask
ASK_MAX_QUESTION_CHARS=500
ASK_MAX_ROWS=200
ASK_MAX_RESULT_BYTES=1000000
ASK_MAX_REPAIR_ATTEMPTS=1
ASK_SCHEMA_CACHE_SECONDS=600
ASK_SAMPLE_VALUES_MAX=8
ASK_SAMPLE_VALUES_MAX_DISTINCT=12
ASK_DENIED_FUNCTIONS=pg_sleep,pg_read_file,pg_read_binary_file,pg_ls_dir,set_config,dblink,current_setting,txid_current,nextval,setval,currval,lastval,query_to_xml,table_to_xml,cursor_to_xml,schema_to_xml,database_to_xml
ASK_DEFAULT_KEY_DAILY_LIMIT=20

# Confidence score
CONFIDENCE_WEIGHT_SELF=0.4
CONFIDENCE_WEIGHT_CLEAN_GUARD=0.15
CONFIDENCE_WEIGHT_NO_RETRY=0.25
CONFIDENCE_WEIGHT_NON_EMPTY=0.2
CONFIDENCE_PENALTY_TRUNCATED=0.1
