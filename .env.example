# Docker Compose (infra/docker-compose.yml). Copy to `.env`. No defaults:
# compose stops if any of these is missing.

# Postgres superuser (local only). backend/.env and backend/.env.test use
# these in their database URLs; change all three together.
POSTGRES_USER=querylab
POSTGRES_PASSWORD=querylab

# Host ports.
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Backend image build: uv download tuning (seconds per request, parallel
# downloads). Raise the timeout and lower the parallelism on a slow link.
UV_HTTP_TIMEOUT=300
UV_CONCURRENT_DOWNLOADS=2
