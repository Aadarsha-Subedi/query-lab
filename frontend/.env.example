# Querylab frontend. Copy to `.env`. Every key is required.

# ── Read by the app in the browser (validated with Zod at startup) ──
# Origin the browser calls for /api and /_allauth. Locally that is the Vite dev
# server itself (it proxies to Django), so cookies stay same-origin.
VITE_API_BASE_URL=http://localhost:5173
VITE_APP_NAME=Querylab

# ── Read by the Vite dev server only (validated in env.config.ts) ──
DEV_SERVER_PORT=5173
API_PROXY_TARGET=http://backend:8000
